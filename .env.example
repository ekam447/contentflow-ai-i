# ContentFlow AI environment variables
# Copy this file to .env.local and fill in your values.
# Do not commit .env.local to version control.

# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI provider (server-side only, not exposed to browser)
# Set these in your Edge Function / server environment, NOT in VITE_ variables here
# VITE_AI_PROVIDER=gemini
# VITE_AI_API_KEY=your-server-side-key (keep secret, never commit)
